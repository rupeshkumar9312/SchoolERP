# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Local Postgres (Homebrew): postgresql://<your-mac-user>@localhost:5432/school_erp?schema=public
# Docker Compose (see docker-compose.yml at the repo root):
DATABASE_URL="postgresql://schoolerp:schoolerp@localhost:5432/school_erp?schema=public"

# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-to-a-random-32-byte-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Local MySQL (Homebrew): mysql://<your-mac-user>@localhost:3306/school_erp
# Docker Compose (see docker-compose.yml at the repo root):
DATABASE_URL="mysql://schoolerp:schoolerp@localhost:3306/school_erp"

# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-to-a-random-32-byte-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QR teacher attendance (anti-proxy check-in). Leave ATT_QR_SECRET unset to
# keep the kiosk/scan endpoints disabled (they return 503). Generate with:
# openssl rand -base64 32
ATT_QR_SECRET=
# ATT_QR_TOKEN_TTL_SEC=25       # QR validity window, seconds
# ATT_QR_ROTATE_SEC=12          # kiosk refresh interval, must be < TTL
# ATT_QR_GRACE_SEC=5            # extra grace on scan validation
# ATT_QR_KIOSK_SESSION_TTL=12h  # kiosk display session lifetime
SCHOOL_TZ=Asia/Kolkata
ATT_CUTOFF=09:00               # HH:mm in SCHOOL_TZ; scan at/after -> LATE
# TEACHER_MANUAL_MARK_ENABLED=true   # set false in Phase 5 to force QR-only

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Cloudinary — stores assignment attachments (local disk doesn't survive a
# serverless deploy). Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

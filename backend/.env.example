# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Local MySQL (Homebrew): mysql://<your-mac-user>@localhost:3306/school_erp
# Docker Compose (see docker-compose.yml at the repo root):
DATABASE_URL="mysql://schoolerp:schoolerp@localhost:3306/school_erp"

# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-to-a-random-32-byte-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Cloudinary — stores assignment attachments (local disk doesn't survive a
# serverless deploy). Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

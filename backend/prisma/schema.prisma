// School ERP — Prisma schema
//
// Module 1 (Auth & RBAC) — first real tables: users, roles, permissions,
// role_permissions. Roles/permissions are DB-driven (not enums) so Module 12
// can offer a role/permission management UI without a code change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                      Int                 @id @default(autoincrement())
  email                   String              @unique
  passwordHash            String
  name                    String
  phone                   String?
  isActive                Boolean             @default(true)
  roleId                  Int
  role                    Role                @relation(fields: [roleId], references: [id])
  /// bcrypt hash of the current refresh token, cleared on logout — lets us
  /// revoke a stolen refresh token without a separate token-blacklist table.
  hashedRefreshToken      String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  teacher                 Teacher?
  markedAttendance        StudentAttendance[] @relation("AttendanceMarkedBy")
  markedTeacherAttendance TeacherAttendance[] @relation("TeacherAttendanceMarkedBy")
  auditLogs               AuditLog[]          @relation("AuditLogActor")

  @@map("users")
}

model AcademicYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  /// Only one row may be true at a time — enforced in AcademicService, not the DB.
  isCurrent Boolean  @default(false)
  classes   Class[]
  createdAt DateTime @default(now())

  @@map("academic_years")
}

model Class {
  id                  Int                   @id @default(autoincrement())
  name                String
  academicYearId      Int
  academicYear        AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sections            Section[]
  subjects            Subject[]
  assignments         TeacherClassSubject[]
  students            Student[]
  attendance          StudentAttendance[]
  homeworkAssignments Assignment[]
  createdAt           DateTime              @default(now())

  @@unique([academicYearId, name])
  @@map("classes")
}

model Section {
  id                  Int                   @id @default(autoincrement())
  name                String
  classId             Int
  class               Class                 @relation(fields: [classId], references: [id], onDelete: Restrict)
  assignments         TeacherClassSubject[]
  students            Student[]
  attendance          StudentAttendance[]
  /// The homeroom teacher, distinct from a TeacherClassSubject row: a subject
  /// teacher can be assigned to teach here without being able to mark
  /// attendance for it. Nullable — a section may have no class teacher yet,
  /// and a teacher may hold this for zero, one, or several sections.
  classTeacherId      Int?
  classTeacher        Teacher?              @relation("ClassTeacherOf", fields: [classTeacherId], references: [id], onDelete: SetNull)
  homeworkAssignments Assignment[]
  createdAt           DateTime              @default(now())

  @@unique([classId, name])
  @@map("sections")
}

model Subject {
  id                  Int                   @id @default(autoincrement())
  name                String
  classId             Int
  class               Class                 @relation(fields: [classId], references: [id], onDelete: Restrict)
  assignments         TeacherClassSubject[]
  homeworkAssignments Assignment[]
  createdAt           DateTime              @default(now())

  @@unique([classId, name])
  @@map("subjects")
}

model Teacher {
  id                  Int                   @id @default(autoincrement())
  userId              Int                   @unique
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification       String?
  joiningDate         DateTime
  assignments         TeacherClassSubject[]
  attendance          TeacherAttendance[]
  classTeacherOf      Section[]             @relation("ClassTeacherOf")
  homeworkAssignments Assignment[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@map("teachers")
}

/// A teacher's assignment to teach one subject to one class+section.
model TeacherClassSubject {
  id        Int      @id @default(autoincrement())
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   Int
  class     Class    @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionId Int
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([teacherId, classId, sectionId, subjectId])
  @@map("teacher_class_subject")
}

/// Coursework/homework a teacher sets for a class+section+subject — distinct
/// from TeacherClassSubject above (which is "who teaches what," not "what was
/// assigned"). Field name on the back-relations is `homeworkAssignments` to
/// keep it unambiguous next to Class/Section/Subject/Teacher's existing
/// `assignments` (TeacherClassSubject) relation.
model Assignment {
  id                 Int                    @id @default(autoincrement())
  title              String
  description        String?
  classId            Int
  class              Class                  @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionId          Int
  section            Section                @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subjectId          Int
  subject            Subject                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  /// Owner — the only teacher who may view/edit/delete this row. Cascades
  /// with the teacher (same rule as TeacherClassSubject/TeacherAttendance):
  /// deleting a Teacher's login removes their homework too.
  teacherId          Int
  teacher            Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dueDate            DateTime               @db.Date
  /// Recurring assignments are materialized eagerly as N independent rows at
  /// creation time (no scheduler in this app) — this just links siblings so
  /// the UI can show "part of a weekly series" without a separate table.
  seriesId           String?
  /// File on local disk under backend/uploads/assignments/ — path is never
  /// exposed to the client, only attachmentFileName + a proxied download route.
  attachmentPath     String?
  attachmentFileName String?
  attachmentMimeType String?
  attachmentSize     Int?
  submissions        AssignmentSubmission[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([classId, sectionId])
  @@index([teacherId])
  @@map("assignments")
}

/// A teacher-operated submission checklist — there is no student login in
/// this app (see README), so a student can never mark their own work
/// submitted; the owning teacher records it on their behalf, the same way
/// StudentAttendance is staff-recorded rather than self-reported.
model AssignmentSubmission {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submitted    Boolean    @default(false)
  submittedAt  DateTime?
  remarks      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Student {
  id                    Int                    @id @default(autoincrement())
  admissionNo           String                 @unique
  name                  String
  dateOfBirth           DateTime?
  gender                String?
  classId               Int
  class                 Class                  @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionId             Int
  section               Section                @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  guardianName          String?
  guardianPhone         String?
  guardianEmail         String?
  address               String?
  isActive              Boolean                @default(true)
  admissionDate         DateTime               @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  attendance            StudentAttendance[]
  assignmentSubmissions AssignmentSubmission[]

  @@map("students")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

model StudentAttendance {
  id         Int              @id @default(autoincrement())
  studentId  Int
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  /// Snapshot of the student's class/section on the marked date, so a later
  /// class change doesn't rewrite history or break filtering by past class.
  classId    Int
  class      Class            @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionId  Int
  section    Section          @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  markedById Int
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([studentId, date])
  @@map("student_attendance")
}

/// Staff attendance, separate from StudentAttendance — a teacher self-marks
/// their own row; admins may mark/edit any teacher's row for any date.
model TeacherAttendance {
  id         Int              @id @default(autoincrement())
  teacherId  Int
  teacher    Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  markedById Int
  markedBy   User             @relation("TeacherAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([teacherId, date])
  @@map("teacher_attendance")
}

/// A non-teaching day, excluded from attendance % calculations in Reports.
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())

  @@map("holidays")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// Accountability trail for mutations on students, teachers, attendance and
/// staff accounts. userId is nullable (not optional in practice — every write
/// goes through an authenticated route) so deleting the actor's own account
/// later doesn't erase the history of what they did; onDelete: SetNull keeps
/// the row instead of cascading it away.
model AuditLog {
  id         Int         @id @default(autoincrement())
  entityType String
  entityId   Int
  action     AuditAction
  userId     Int?
  user       User?       @relation("AuditLogActor", fields: [userId], references: [id], onDelete: SetNull)
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// School ERP — Prisma schema
//
// Module 1 (Auth & RBAC) — first real tables: users, roles, permissions,
// role_permissions. Roles/permissions are DB-driven (not enums) so Module 12
// can offer a role/permission management UI without a code change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                      Int                 @id @default(autoincrement())
  email                   String              @unique
  /// Auto-generated, immutable identity code: 'EDV-ADM-000123' /
  /// 'EDV-TCH-000123' / 'EDV-STU-000123'. For TEACHER/STUDENT this is also
  /// the lowercased local part of `email`; for admin-tier roles `email` is
  /// instead derived from `name`, so the two are independent there. Never
  /// editable after creation — no update DTO exposes it.
  edvanceId               String              @unique
  passwordHash            String
  name                    String
  phone                   String?
  isActive                Boolean             @default(true)
  roleId                  Int
  role                    Role                @relation(fields: [roleId], references: [id])
  /// True until the user sets their own password — forces a change-password
  /// screen on first login for every login this app ever creates (seed,
  /// staff, teacher, or student admission), since all of them start from an
  /// admin-chosen or generated password the user didn't pick themselves.
  mustChangePassword      Boolean             @default(true)
  /// bcrypt hash of the current refresh token, cleared on logout — lets us
  /// revoke a stolen refresh token without a separate token-blacklist table.
  hashedRefreshToken      String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  teacher                 Teacher?
  student                 Student?
  markedAttendance        StudentAttendance[] @relation("AttendanceMarkedBy")
  markedTeacherAttendance TeacherAttendance[] @relation("TeacherAttendanceMarkedBy")
  auditLogs               AuditLog[]          @relation("AuditLogActor")
  loginAudits             LoginAudit[]        @relation("LoginAuditUser")
  announcements           Announcement[]      @relation("AnnouncementAuthor")
  pushTokens              PushToken[]
  createdExams            Exam[]              @relation("ExamCreatedBy")
  createdExamSchedules    ExamSchedule[]      @relation("ExamScheduleCreatedBy")
  enteredExamMarks        ExamMark[]          @relation("ExamMarkEnteredBy")

  @@map("users")
}

/// One row per Edvance-ID prefix ('ADM' | 'TCH' | 'STU'). lastValue is
/// incremented transactionally alongside the User create that consumes it —
/// the UPDATE takes a row lock, so concurrent creates never collide.
/// See backend/src/common/generate-edvance-id.ts.
model IdSequence {
  prefix    String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("id_sequences")
}

/// One row per device a user is logged into. `token` is unique (not
/// userId+token) — if the same device later logs in as a different user, the
/// token gets reassigned to them via upsert rather than left pointing at
/// whoever registered it first.
model PushToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_tokens")
}

model AcademicYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  /// Only one row may be true at a time — enforced in AcademicService, not the DB.
  isCurrent Boolean  @default(false)
  classes   Class[]
  createdAt DateTime @default(now())

  @@map("academic_years")
}

model Class {
  id                  Int                   @id @default(autoincrement())
  name                String
  academicYearId      Int
  academicYear        AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sections            Section[]
  subjects            Subject[]
  assignments         TeacherClassSubject[]
  students            Student[]
  attendance          StudentAttendance[]
  homeworkAssignments Assignment[]
  examSchedules       ExamSchedule[]
  createdAt           DateTime              @default(now())

  @@unique([academicYearId, name])
  @@map("classes")
}

model Section {
  id                  Int                   @id @default(autoincrement())
  name                String
  classId             Int
  class               Class                 @relation(fields: [classId], references: [id], onDelete: Restrict)
  assignments         TeacherClassSubject[]
  students            Student[]
  attendance          StudentAttendance[]
  /// The homeroom teacher, distinct from a TeacherClassSubject row: a subject
  /// teacher can be assigned to teach here without being able to mark
  /// attendance for it. Nullable — a section may have no class teacher yet,
  /// and a teacher may hold this for zero, one, or several sections.
  classTeacherId      Int?
  classTeacher        Teacher?              @relation("ClassTeacherOf", fields: [classTeacherId], references: [id], onDelete: SetNull)
  homeworkAssignments Assignment[]
  examMarks           ExamMark[]
  createdAt           DateTime              @default(now())

  @@unique([classId, name])
  @@map("sections")
}

model Subject {
  id                  Int                   @id @default(autoincrement())
  name                String
  classId             Int
  class               Class                 @relation(fields: [classId], references: [id], onDelete: Restrict)
  assignments         TeacherClassSubject[]
  homeworkAssignments Assignment[]
  examSubjects        ExamSubject[]
  createdAt           DateTime              @default(now())

  @@unique([classId, name])
  @@map("subjects")
}

model Teacher {
  id                  Int                   @id @default(autoincrement())
  userId              Int                   @unique
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification       String?
  joiningDate         DateTime
  assignments         TeacherClassSubject[]
  attendance          TeacherAttendance[]
  classTeacherOf      Section[]             @relation("ClassTeacherOf")
  homeworkAssignments Assignment[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@map("teachers")
}

/// A teacher's assignment to teach one subject to one class+section.
model TeacherClassSubject {
  id        Int      @id @default(autoincrement())
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   Int
  class     Class    @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionId Int
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([teacherId, classId, sectionId, subjectId])
  @@map("teacher_class_subject")
}

/// Coursework/homework a teacher sets for a class+section+subject — distinct
/// from TeacherClassSubject above (which is "who teaches what," not "what was
/// assigned"). Field name on the back-relations is `homeworkAssignments` to
/// keep it unambiguous next to Class/Section/Subject/Teacher's existing
/// `assignments` (TeacherClassSubject) relation.
model Assignment {
  id                 Int                    @id @default(autoincrement())
  title              String
  description        String?
  classId            Int
  class              Class                  @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionId          Int
  section            Section                @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subjectId          Int
  subject            Subject                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  /// Owner — the only teacher who may view/edit/delete this row. Cascades
  /// with the teacher (same rule as TeacherClassSubject/TeacherAttendance):
  /// deleting a Teacher's login removes their homework too.
  teacherId          Int
  teacher            Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  dueDate            DateTime               @db.Date
  /// Recurring assignments are materialized eagerly as N independent rows at
  /// creation time (no scheduler in this app) — this just links siblings so
  /// the UI can show "part of a weekly series" without a separate table.
  seriesId           String?
  /// Cloudinary public_id (folder schoolerp/assignments/, uploaded as
  /// type: 'authenticated' — no public URL of its own). Never exposed to the
  /// client; only attachmentFileName + a proxied, auth-gated download route.
  attachmentPath     String?
  attachmentFileName String?
  attachmentMimeType String?
  attachmentSize     Int?
  submissions        AssignmentSubmission[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([classId, sectionId])
  @@index([teacherId])
  @@map("assignments")
}

/// A teacher-operated submission checklist — there is no student login in
/// this app (see README), so a student can never mark their own work
/// submitted; the owning teacher records it on their behalf, the same way
/// StudentAttendance is staff-recorded rather than self-reported.
model AssignmentSubmission {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submitted    Boolean    @default(false)
  submittedAt  DateTime?
  remarks      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Student {
  id                    Int                    @id @default(autoincrement())
  admissionNo           String?                @unique
  name                  String
  dateOfBirth           DateTime?
  gender                String?
  classId               Int
  class                 Class                  @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionId             Int
  section               Section                @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  guardianName          String?
  guardianPhone         String?
  guardianEmail         String?
  address               String?
  isActive              Boolean                @default(true)
  admissionDate         DateTime               @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  /// The student's own portal login (Module 10.6). Nullable so students
  /// admitted before this module keep working with no login; provisioned
  /// automatically for every new admission. Same 1:1 shape and cascade
  /// direction as Teacher.userId — deleting the User row (the login) cascades
  /// to delete this Student row, so StudentsService.remove() deletes via the
  /// User row (when one exists) rather than the Student row directly.
  userId                Int?                   @unique
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance            StudentAttendance[]
  assignmentSubmissions AssignmentSubmission[]
  examMarks             ExamMark[]

  @@index([classId, sectionId, isActive])
  @@map("students")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

model StudentAttendance {
  id         Int              @id @default(autoincrement())
  studentId  Int
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  /// Snapshot of the student's class/section on the marked date, so a later
  /// class change doesn't rewrite history or break filtering by past class.
  classId    Int
  class      Class            @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionId  Int
  section    Section          @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  markedById Int
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([classId, sectionId, date])
  @@index([date])
  @@map("student_attendance")
}

/// Staff attendance, separate from StudentAttendance — a teacher self-marks
/// their own row; admins may mark/edit any teacher's row for any date.
model TeacherAttendance {
  id         Int              @id @default(autoincrement())
  teacherId  Int
  teacher    Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  markedById Int
  markedBy   User             @relation("TeacherAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([teacherId, date])
  @@index([date])
  @@map("teacher_attendance")
}

/// A non-teaching day, excluded from attendance % calculations in Reports.
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())

  @@map("holidays")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// Accountability trail for mutations on students, teachers, attendance and
/// staff accounts. userId is nullable (not optional in practice — every write
/// goes through an authenticated route) so deleting the actor's own account
/// later doesn't erase the history of what they did; onDelete: SetNull keeps
/// the row instead of cascading it away.
model AuditLog {
  id         Int         @id @default(autoincrement())
  entityType String
  entityId   Int
  action     AuditAction
  userId     Int?
  user       User?       @relation("AuditLogActor", fields: [userId], references: [id], onDelete: SetNull)
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum LoginEventType {
  /// A successful email/password login.
  LOGIN
  /// A session silently resumed via the refresh token — no credentials
  /// re-entered (a page reload on web, or the app reopening on mobile).
  REFRESH
  /// A rejected login attempt — wrong password, unknown identifier, or a
  /// disabled account. userId is set only when the identifier resolved to a
  /// real account (a disabled account or wrong password); unknown identifiers
  /// leave it null.
  LOGIN_FAILED
}

enum LoginPlatform {
  WEB
  MOBILE
}

/// Login activity trail — separate from AuditLog above, which tracks
/// mutations to app data, not authentication events. userId is nullable for
/// the same reason as AuditLog.userId (a later account deletion shouldn't
/// erase the history) and additionally because a LOGIN_FAILED row for an
/// identifier that never matched a real account has no user to link to.
model LoginAudit {
  id            Int             @id @default(autoincrement())
  event         LoginEventType
  platform      LoginPlatform
  /// The email/alias exactly as submitted — kept even on success (where it's
  /// redundant with user.email) so every row has a consistent, always-present
  /// field to display/search on.
  identifier    String
  userId        Int?
  user          User?           @relation("LoginAuditUser", fields: [userId], references: [id], onDelete: SetNull)
  /// Only set for LOGIN_FAILED — e.g. "Invalid email or password".
  failureReason String?
  ipAddress     String?
  userAgent     String?         @db.Text
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@map("audit_logins")
}

/// The three visibility groups an announcement can target — deliberately
/// coarser than the six actual roles: ADMIN means every admin-tier role
/// (SUPER_ADMIN/DIRECTOR/PRINCIPAL/ADMIN) collectively, the same grouping
/// already used informally throughout the app (e.g. Assignments' "admin
/// roles see all"), not a literal match on the ADMIN role name.
enum AudienceRole {
  STUDENT
  TEACHER
  ADMIN
}

/// A notice posted by admin-tier staff, targeted at one or more audience
/// groups. createdById is nullable with onDelete: SetNull, same reasoning as
/// AuditLog.userId — deleting the poster's account later shouldn't erase the
/// announcement itself, just its attribution.
model Announcement {
  id          Int                    @id @default(autoincrement())
  title       String
  /// Optional when an image is attached — a viewer needs at least one of
  /// body or image, enforced client-side (mobile form), not here, since the
  /// image is uploaded as a second request after the announcement exists.
  body        String?                @db.Text
  createdById Int?
  createdBy   User?                  @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  audiences   AnnouncementAudience[]
  /// Cloudinary public_id, uploaded as type: 'upload' (public delivery) —
  /// unlike Assignment/LeaveApplication attachments, an announcement image is
  /// meant to render inline for every viewer in its audience with no
  /// auth-gated download step, so it has no signed-URL indirection. Null for
  /// every announcement posted before this field existed, and for any
  /// announcement posted without an image since.
  imagePath   String?
  /// The direct https delivery URL Cloudinary returned at upload time —
  /// stored rather than regenerated per-request since a public asset's URL
  /// is stable. Clients render this directly (e.g. <Image source={{ uri }}>).
  imageUrl    String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@map("announcements")
}

/// Join table, same shape as RolePermission — one row per (announcement,
/// audience group). A composite PK instead of a JSON array column keeps
/// "which announcements target TEACHER" a plain, indexable relation filter.
model AnnouncementAudience {
  announcementId Int
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  audience       AudienceRole

  @@id([announcementId, audience])
  @@map("announcement_audiences")
}

enum ExamType {
  CLASS_TEST
  UNIT_TEST
  MID_TERM
  TERM_EXAM
  FINAL_EXAM
  OTHER
}

enum ExamScheduleStatus {
  DRAFT
  PUBLISHED
}

/// The exam's identity — "Unit Test 1", "Term 1 Exam" — plus an optional
/// overall date window shown at creation time. No classId, no subjects of
/// its own: those belong to its ExamSchedule children, one per class the
/// exam has been scheduled for, each with its own independent dates that
/// may differ from this overall window. Renaming here updates every class's
/// sitting of it at once, since the name is stored exactly once.
model Exam {
  id          Int            @id @default(autoincrement())
  name        String
  type        ExamType
  startDate   DateTime?      @db.Date
  endDate     DateTime?      @db.Date
  createdById Int?
  createdBy   User?          @relation("ExamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  schedules   ExamSchedule[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("exams")
}

/// One class's sitting of an Exam — "Unit Test 1, for Class 8": its own date
/// window, its own subject list, its own publish status (no publish routes
/// exist yet — Phase 3). Fully independent of every other class's schedule
/// under the same Exam — no shared subject template, no name-matching, and
/// its dates are independent of the parent Exam's own startDate/endDate. No
/// separate academicYearId column: a Class's academicYearId never changes
/// post-creation, so filtering by year goes through `class.academicYearId`.
model ExamSchedule {
  id          Int                 @id @default(autoincrement())
  examId      Int
  exam        Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId     Int
  class       Class               @relation(fields: [classId], references: [id], onDelete: Restrict)
  startDate   DateTime            @db.Date
  endDate     DateTime            @db.Date
  status      ExamScheduleStatus  @default(DRAFT)
  createdById Int?
  createdBy   User?               @relation("ExamScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  subjects    ExamSubject[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([examId, classId])
  @@index([classId])
  @@map("exam_schedules")
}

/// One subject's paper within an ExamSchedule — its own max/pass marks and
/// date, since different subjects in the same schedule are graded out of
/// different totals and held on different days.
model ExamSubject {
  id             Int          @id @default(autoincrement())
  examScheduleId Int
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  subjectId      Int
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  maxMarks       Int
  passMarks      Int?
  examDate       DateTime?    @db.Date
  marks          ExamMark[]
  createdAt      DateTime     @default(now())

  @@unique([examScheduleId, subjectId])
  @@map("exam_subjects")
}

/// One student's result for one subject's paper. sectionId is a snapshot
/// (same reasoning as StudentAttendance.classId/sectionId) so a later
/// section change never rewrites history or breaks a teacher's marks-entry
/// scope check for what they already graded.
model ExamMark {
  id            Int         @id @default(autoincrement())
  examSubjectId Int
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  studentId     Int
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId     Int
  section       Section     @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  marksObtained Int?
  isAbsent      Boolean     @default(false)
  remarks       String?
  enteredById   Int?
  enteredBy     User?       @relation("ExamMarkEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([examSubjectId, studentId])
  @@map("exam_marks")
}
